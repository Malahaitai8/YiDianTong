<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboot.mapper.WhitelistMapper">
    <resultMap id="WhitelistResultMap" type="com.example.springboot.entity.Whitelist">
        <id column="id" property="id"/>
        <result column="identity_number" property="identityNumber"/>
        <result column="role_type" property="roleType"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectAll" resultMap="WhitelistResultMap">
        select * from whitelist
        order by created_at desc
    </select>

    <select id="selectById" resultMap="WhitelistResultMap">
        select * from whitelist
        where id = #{id}
    </select>

    <select id="selectByIdentityNumber" resultMap="WhitelistResultMap">
        select * from whitelist
        where identity_number = #{identityNumber}
        and status = 'active'
    </select>

    <select id="selectByIdentityNumberAnyStatus" resultMap="WhitelistResultMap">
        select * from whitelist
        where identity_number = #{identityNumber}
    </select>
    

    <select id="selectByRoleType" resultMap="WhitelistResultMap">
        select * from whitelist
        where role_type = #{roleType}
        and status = 'active'
        order by created_at desc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into whitelist(identity_number, role_type, status)
        values(#{identityNumber}, #{roleType}, #{status})
    </insert>

    <update id="update">
        update whitelist
        <set>
            <if test="identityNumber != null">identity_number = #{identityNumber},</if>
            <if test="roleType != null">role_type = #{roleType},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete">
        delete from whitelist where id = #{id}
    </delete>

</mapper>

