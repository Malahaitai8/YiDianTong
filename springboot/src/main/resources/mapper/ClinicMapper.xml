<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboot.mapper.ClinicMapper">
    <select id="selectAll" resultType="com.example.springboot.entity.Clinic">
        select * from clinic
    </select>

    <select id="selectById" resultType="com.example.springboot.entity.Clinic">
        select * from clinic where id = #{id}
    </select>

    <select id="selectByName" resultType="com.example.springboot.entity.Clinic">
        select * from clinic where name = #{name}
    </select>

    <insert id="insert" parameterType="com.example.springboot.entity.Clinic" useGeneratedKeys="true" keyProperty="id">
        insert into clinic (department_id, name, description)
        values (#{departmentId}, #{name}, #{description})
    </insert>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into clinic (department_id, name, description) values
        <foreach collection="list" item="item" separator=",">
            (#{item.departmentId}, #{item.name}, #{item.description})
        </foreach>
    </insert>

    <update id="update" parameterType="com.example.springboot.entity.Clinic">
        update clinic
        set department_id = #{departmentId},
            name = #{name},
            description = #{description}
        where id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        delete from clinic where id = #{id}
    </delete>

</mapper>
