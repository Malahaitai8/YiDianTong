<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springboot.mapper.PatientMapper">
    <select id="selectAll" resultType="com.example.springboot.entity.Patient">
        select * from patient
    </select>

    <select id="selectById" resultType="com.example.springboot.entity.Patient">
        select * from patient where id = #{id}
    </select>

    <select id="selectByPhoneNumber" resultType="com.example.springboot.entity.Patient">
        select * from patient where phone_number = #{phoneNumber}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into patient(password, name, role, id_status, phone_number, id_card_number)
        values(#{password}, #{name}, #{role}, #{idStatus}, #{phoneNumber}, #{idCardNumber})
    </insert>

</mapper>
