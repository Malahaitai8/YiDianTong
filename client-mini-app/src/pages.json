{
	"easycom": {
		"autoscan": true,
		"custom": {
			"van-(.*)": "vant-aliapp/dist/dist/$1/index"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "医点通"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/register/register",
			"style": {
				"navigationBarTitleText": "注册"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "个人信息"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "医点通",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"subPackages": [
		{
			"root": "pkg-user",
			"pages": [
				{
					"path": "my-profile/my-profile",
					"style": {"navigationBarTitleText": "个人中心"}
				},
				{
					"path": "my-substitute/my-substitute",
					"style": {"navigationBarTitleText": "我的候补"}
				}
			]
		},
		{
			"root": "pkg-order",
			"pages": [
				{
					"path": "order-confirm/order-confirm",
					"style": {"navigationBarTitleText": "确认挂号"}
				}
			]
		},
		{
			"root": "pkg-helper",
			"pages": [
				{
					"path": "qa-robot/qa-robot",
					"style": {"navigationBarTitleText": "智能问答"}
				}
			]
		}
	]
}